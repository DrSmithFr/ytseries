{% set movies = movies|default([]) %}
{% set isTop10 = isTop10|default(false) %}
{% set sectionTitle = sectionTitle|default(isTop10 ? 'Top 10' : 'Nouveautés sur YTseries') %}

<section class="movies{% if isTop10 %} top10{% endif %}">
    <div class="movies-container">
        <h1 class="movies-title">{{ sectionTitle }}</h1>
        <div class="movies-list">
            {# @var movie App\Entity\Series #}
            {% for movie in movies %}
                <div
                    class="movie main"
                    data-controller="popover"
                    data-popover-target="wrapper"
                    data-action="mouseenter->popover#scheduleShow mouseleave->popover#cancelShow"
                >
                    <div class="thumb">

                        {% if isTop10 %}
                            <picture class="vertical">
                                <source srcset="{{ movie.image| imagine_filter('movie_vertical_webp') }}" type="image/webp">
                                <source srcset="{{ movie.image| imagine_filter('movie_vertical_png') }}" type="image/png">
                                <img src="{{ movie.image| imagine_filter('movie_vertical_png') }}" alt="">
                            </picture>
                        {% else %}
                            <picture class="horizontal">
                                <source srcset="{{ movie.image| imagine_filter('movie_horizontal_webp') }}" type="image/webp">
                                <source srcset="{{ movie.image| imagine_filter('movie_horizontal_png') }}" type="image/png">
                                <img src="{{ movie.image| imagine_filter('movie_horizontal_png') }}" alt="">
                            </picture>
                        {% endif %}

                        <div class="tags">
                            {% if movie.createdAt > (date()|date_modify('-1 month')) %}
                                <span class="important">Ajout récent</span>
                            {% endif %}

                            {% for tag in movie.tags %}
                                <span>{{ tag }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <template data-popover-target="content">
                        {{ include('app/_movie_section_modal.html.twig') }}
                    </template>

                </div>
            {% endfor %}


        </div>
    </div>
</section>
